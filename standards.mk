CLK_ENABLE_NAME := clk_en
CLK_ENABLE_REQUIRED := 1
CLOCK_NAME := clk
CROSS_REFS_STYLE := vhdl_style.md
DIR_LAYOUT_SRC_FILES := {Name}.vhd {Name}_Regs.vhd {Name}_Core.vhd
DIR_LAYOUT_TB_FILES := tb_{Name}.vhd
FILE_EXTENSION := .vhd
INDENT := 2
LINE_LENGTH := 120
NAMING_ARCHITECTURE_ALLOWED := rtl behave tb
NAMING_CONSTANT_PATTERN := ^[A-Z0-9_]+$
NAMING_ENTITIES_PATTERN := ^[A-Z][A-Za-z0-9_]*$
NAMING_MODULE_NAME_CASE := PascalCase
NAMING_SIGNAL_PATTERN := ^[a-z0-9_]+$
PACKAGES_FORBIDDEN := std_logic_arith std_logic_unsigned
PACKAGES_REQUIRED := ieee.std_logic_1164.all ieee.numeric_std.all
REQUIRED_ENTITIES := {Name}_Core
RESET_ACTIVE_LOW := 1
RESET_NAME := rst_n
RESET_SYNCHRONOUS := 1
RESET_POLICY_REFERENCE := standards/vhdl_style.md#clocking--reset
TESTBENCH_MAGIC_DONE := SIMULATION DONE
TESTBENCH_MAGIC_PASS := ALL TESTS PASSED
VERSION := 1
VHDL_STANDARD := 2008
