# Makefile for ProbeDriver MCC Synthesis
# This Makefile compiles the refactored ProbeDriver architecture for MCC synthesis
#
# Date: 2025-01-27
# Tag: ProbeDriver-v1.0-Refactored

# Compiler and flags
VHDL_STD = 08
VHDL_FLAGS = --std=$(VHDL_STD) --ieee=synopsys

# Target files for synthesis
TARGET = ProbeDriver_Top.vhd

# Source files in dependency order
SOURCES = \
	../clk-divider/clk_divider.vhd \
	common/intensity_lut_pkg.vhd \
	common/probe_driver_pkg.vhd \
	core/probe_driver_core.vhd \
	$(TARGET)

# Default target
all: compile

# Compile all sources in dependency order
compile: $(SOURCES)
	@echo "Compiling ProbeDriver for MCC synthesis..."
	@echo "Compiling clk_divider..."
	ghdl -a $(VHDL_FLAGS) ../clk-divider/clk_divider.vhd
	@echo "Compiling intensity_lut_pkg..."
	ghdl -a $(VHDL_FLAGS) common/intensity_lut_pkg.vhd
	@echo "Compiling probe_driver_pkg..."
	ghdl -a $(VHDL_FLAGS) common/probe_driver_pkg.vhd
	@echo "Compiling probe_driver_core..."
	ghdl -a $(VHDL_FLAGS) core/probe_driver_core.vhd
	@echo "Compiling ProbeDriver_Top..."
	ghdl -a $(VHDL_FLAGS) $(TARGET)
	@echo "Compilation complete!"

# Clean generated files
clean:
	@echo "Cleaning generated files..."
	rm -f *.o *.cf *.vcd
	@echo "Clean complete!"

# Show dependency tree
deps:
	@echo "ProbeDriver dependency tree:"
	@echo "  clk_divider.vhd (clock divider)"
	@echo "  intensity_lut_pkg.vhd (intensity lookup table)"
	@echo "  probe_driver_pkg.vhd (shared package)"
	@echo "  probe_driver_core.vhd (state machine)"
	@echo "  ProbeDriver_Top.vhd (top-level CustomWrapper)"

# Help
help:
	@echo "ProbeDriver MCC Synthesis Makefile"
	@echo ""
	@echo "Targets:"
	@echo "  all      - Compile all sources (default)"
	@echo "  compile  - Compile all sources"
	@echo "  clean    - Remove generated files"
	@echo "  deps     - Show dependency tree"
	@echo "  help     - Show this help"
	@echo ""
	@echo "Usage:"
	@echo "  make        # Compile everything"
	@echo "  make clean  # Clean generated files"
	@echo "  make deps   # Show dependencies"

.PHONY: all compile clean deps help
